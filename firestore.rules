rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // بدّلي البريد بإيميل المسؤول (يمكن إضافة أكثر من بريد داخل القوسين)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['procurement@valuecapital.sa'];
    }
    function signedIn() { return request.auth != null; }

    match /pr/{id} {
      allow read:   if isAdmin() || (signedIn() && resource.data.requesterId == request.auth.uid);
      allow create: if isAdmin() || (signedIn()
                        && request.resource.data.requesterId == request.auth.uid
                        && request.resource.data.status == 'new');
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn()
                        && resource.data.requesterId == request.auth.uid
                        && resource.data.status == 'new');
    }

    match /po/{id} {
      allow read, create: if isAdmin();
      // بعد التوقيع الإلكتروني: لا يُعدَّل الأمر (الأصناف والإجمالي والتوقيع) ولا يُحذف، ويبقى تغيير الحالة فقط
      allow update: if isAdmin() && (!('signedAt' in resource.data)
                        || (request.resource.data.items == resource.data.items
                            && request.resource.data.total == resource.data.total
                            && request.resource.data.sigs == resource.data.sigs
                            && request.resource.data.signedAt == resource.data.signedAt));
      allow delete: if isAdmin() && !('signedAt' in resource.data);
    }
  }
}
